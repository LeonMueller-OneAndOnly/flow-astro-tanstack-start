---
import Header from "../app/components/Header";
import { $appPath } from "../app/lib/framework/typesafe-paths";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;

/**
 * HINWEIS FÜR AGENTEN
 *
 * Diese Seite ist ein Platzhalter — die Begrüßung, die ein Kunde sieht, wenn
 * sein frisch angelegtes Omnis-Projekt zum ersten Mal ausgeliefert wird. Sie
 * gehört nicht zum Produkt, sie überbrückt nur die Zeit bis zum ersten Auftrag.
 *
 * Solange diese Datei seit dem Anlegen des Projekts durch keinen Commit
 * verändert wurde, darf sie beim ersten Auftrag des Nutzers vollständig
 * überschrieben werden — und soll es auch. Nichts hier ist erhaltenswert: kein
 * Text, kein Layout, keine Struktur. Erst wenn ein Commit die Seite angefasst
 * hat, steckt darin eine Entscheidung des Nutzers, die zu respektieren ist.
 *
 * Prüfen mit: `git log --oneline -- src/pages/index.astro`
 */

const demoHubHref = $appPath({ to: "/demo" });

/**
 * Drei Schritte statt eines Fließtextes, weil die eigentliche Botschaft ein
 * Ablauf ist: sagen, warten, sehen. Die Tints laufen durch, damit die Schritte
 * als Abfolge lesbar bleiben und nicht als drei gleichwertige Kacheln.
 */
const steps = [
  {
    tint: "bg-tint-sky text-tint-sky-ink",
    title: "Du sagst, was du willst",
    detail: "In normalen Sätzen. „Oben soll unser Logo hin, darunter die Öffnungszeiten.“",
  },
  {
    tint: "bg-tint-mint text-tint-mint-ink",
    title: "Dein Agent baut es",
    detail: "Er schreibt den Code, prüft ihn und stellt die Seite neu bereit.",
  },
  {
    tint: "bg-tint-sun text-tint-sun-ink",
    title: "Du siehst es hier",
    detail: "Diese Seite aktualisiert sich, sobald die Änderung fertig ist. Live, ohne Neustart.",
  },
];
---

<BaseLayout
  title="Willkommen — hier entsteht deine Website"
  description="Die Live-Vorschau deines Omnis-Projekts. Sag deinem Agenten, was sich ändern soll, und sieh direkt hier zu."
>
  <Header variant="site" client:load />

  <main class="mx-auto w-full max-w-3xl px-5 pt-16 pb-28 sm:px-8">
    <section>
      <p
        class="inline-flex items-center gap-2 rounded-full bg-brand-soft px-3.5 py-1.5 text-sm font-medium text-brand-ink"
      >
        <span class="size-2 rounded-full bg-brand"></span>
        Live-Vorschau
      </p>

      <h1 class="mt-6 text-4xl leading-[1.12] font-semibold tracking-tight text-balance sm:text-5xl">
        Schön, dass du da bist. <span class="text-brand">Hier entsteht dein Projekt.</span>
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
        Der Entwicklungs-Server ist angelegt und läuft. Was du gerade siehst, ist noch nichts von dir — es ist
        die Vorschau, die jedes neue Projekt am Anfang zeigt. Ab jetzt bestimmst du, was hier steht.
      </p>
    </section>

    <section class="mt-12 grid gap-4 sm:grid-cols-3" aria-label="So geht es weiter">
      {
        steps.map((step, index) => (
          <div class="shadow-soft rounded-xl border border-border bg-card p-6">
            <span
              class={`inline-flex size-9 items-center justify-center rounded-lg text-sm font-semibold ${step.tint}`}
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <h2 class="mt-4 font-semibold tracking-tight">{step.title}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{step.detail}</p>
          </div>
        ))
      }
    </section>

    {/* Ein konkreter Satz zum Abschreiben nimmt mehr Hemmung als jede Erklärung,
        wie man mit einem Agenten redet. */}
    <section class="mt-10 rounded-xl border border-border bg-secondary/60 p-6">
      <p class="text-sm font-medium">Zum Ausprobieren, einfach so gesagt:</p>
      <p class="mt-2 text-lg leading-relaxed text-balance">
        „Mach aus der Startseite eine Begrüßung für meine Kunden, mit unserem Namen, einem kurzen
        Satz dazu, was wir machen, und unseren Kontaktdaten.“
      </p>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
        Lass diese Seite dabei ruhig verschwinden. Sie ist nur der Anfang, nichts, was erhalten
        bleiben muss.
      </p>
    </section>

    <section
      class="mt-16 border-t border-border pt-8 text-sm leading-relaxed text-muted-foreground"
      aria-label="Hinweise"
    >
      <p>
        Diese Adresse ist deine Vorschau — sie zeigt immer den aktuellen Stand, auch mitten in der
        Arbeit. Es kann also sein, dass sich hier etwas ändert, während du zusiehst.
      </p>
      <p class="mt-3">
        Für Entwickler: die mitgelieferten Beispiele liegen unter <a
          class="font-medium text-foreground underline underline-offset-4"
          href={demoHubHref}>/app/demo</a
        >.
      </p>
    </section>
  </main>
</BaseLayout>
