---
import { brandPageBackground } from "../app/lib/brand-theme";
import { $appPath } from "../app/lib/typesafe-paths";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = false;

const demoHubHref = $appPath({ to: "/demo" });
---

<BaseLayout
  title="Astro + TanStack Start Starter"
  description="A starter kit pairing static Astro pages with a TanStack Start app mounted under /app."
>
  <main class="page-shell" style={`background:${brandPageBackground.background}`}>
    <section class="hero">
      <p class="eyebrow">Astro + TanStack Start</p>
      <h1>A starter kit, not a real app yet.</h1>
      <p class="lede">
        Astro serves the static front door. TanStack Start, mounted under <code>/app</code>, handles
        the interactive, app-like routes. The bundled examples live behind one link so you can
        explore them — then delete them in one move.
      </p>

      <div class="actions" aria-label="Primary actions">
        <a class="btn btn-primary" href={demoHubHref}>Browse the demos</a>
        <a
          class="btn btn-secondary"
          href="https://docs.astro.build"
          target="_blank"
          rel="noopener noreferrer">Astro docs</a
        >
        <a
          class="btn btn-secondary"
          href="https://tanstack.com/start"
          target="_blank"
          rel="noopener noreferrer">TanStack Start docs</a
        >
      </div>
    </section>

    <section class="section split" aria-label="Stack overview">
      <article>
        <span>Astro</span>
        <h2>Static front door</h2>
        <p>
          Marketing, content, docs, and low-interactivity SSR. Fast to ship, easy to replace. This
          page is one of them.
        </p>
      </article>
      <article>
        <span>TanStack Start</span>
        <h2>App under <code>/app</code></h2>
        <p>
          Typed server functions, mutations, shared client/server loading, and authenticated flows
          for richer client behavior.
        </p>
      </article>
      <article>
        <span>Demos</span>
        <h2>All under <code>/demo</code></h2>
        <p>
          Every example sits beneath the <code>/demo</code> route segment. Drop <code
            >src/app/routes/demo</code
          > and <code>src/app/lib/demo</code> to remove them all.
        </p>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .page-shell {
    min-height: 100vh;
    padding: clamp(18px, 3vw, 40px);
    /* Background is applied inline from brandPageBackground (src/app/lib/brand-theme.ts),
       the single source shared with the TanStack demo pages. */
    color: var(--foreground);
  }

  .hero {
    width: min(1100px, 100%);
    margin: 0 auto;
    padding: clamp(48px, 10vw, 120px) 0 clamp(28px, 5vw, 56px);
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--brand-secondary-700);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 820px;
    margin: 0 0 24px;
    font-size: clamp(3rem, 8vw, 6.4rem);
    font-weight: 950;
    line-height: 0.92;
    letter-spacing: -0.06em;
  }

  .lede {
    max-width: 680px;
    margin: 0;
    color: color-mix(in oklch, var(--foreground) 68%, transparent);
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0 22px;
    font-weight: 850;
    text-decoration: none;
    transition: transform 160ms ease, border-color 180ms ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: var(--foreground);
    color: var(--background);
    box-shadow: 0 18px 36px color-mix(in oklch, var(--foreground) 18%, transparent);
  }

  .btn-secondary {
    border-color: color-mix(in oklch, var(--foreground) 20%, transparent);
    background: color-mix(in oklch, var(--card) 72%, transparent);
    color: var(--foreground);
  }

  .btn-secondary:hover {
    border-color: color-mix(in oklch, var(--brand-secondary-600) 55%, transparent);
  }

  .section {
    width: min(1100px, 100%);
    margin-inline: auto;
  }

  .split {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    padding-bottom: clamp(32px, 6vw, 72px);
  }

  .split article {
    border: 1px solid color-mix(in oklch, var(--foreground) 12%, transparent);
    border-radius: 26px;
    padding: 24px;
    background: color-mix(in oklch, var(--card) 76%, transparent);
  }

  .split span {
    display: inline-flex;
    margin-bottom: 26px;
    border-radius: 999px;
    padding: 7px 11px;
    background: color-mix(in oklch, var(--brand-secondary-500) 13%, transparent);
    color: var(--brand-secondary-800);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .split h2 {
    margin: 0 0 10px;
    font-size: 1.3rem;
    letter-spacing: -0.035em;
  }

  .split p {
    margin: 0;
    color: color-mix(in oklch, var(--foreground) 60%, transparent);
    line-height: 1.65;
  }

  code {
    border-radius: 8px;
    padding: 2px 7px;
    background: color-mix(in oklch, var(--foreground) 8%, transparent);
    color: var(--brand-secondary-700);
    font-size: 0.9em;
    font-weight: 750;
  }

  @media (max-width: 820px) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .page-shell {
      padding: 16px;
    }

    .btn {
      width: 100%;
    }
  }
</style>
