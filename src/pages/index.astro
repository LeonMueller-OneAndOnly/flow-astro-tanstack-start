---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;

let tanstackNames: Array<string> = [];
let tanstackApiError = "";

try {
  const response = await fetch(new URL("/app/demo/api/names", Astro.url));

  if (!response.ok) {
    throw new Error(`TanStack API returned ${response.status}`);
  }

  tanstackNames = await response.json();
} catch (error) {
  tanstackApiError = error instanceof Error ? error.message : "Unable to load TanStack API data";
}
---

<BaseLayout>
  <main class="page-shell">
    <section class="hero-card">
      <p class="eyebrow">Framework starter</p>
      <h1>Astro shell with a TanStack Start app</h1>
      <p class="lede">
        This is placeholder scaffolding only. Use it to verify routing, rendering, API routes,
        and server functions before replacing the sample content with a real app.
      </p>
      <div class="actions">
        <a class="primary" href="/app">Open TanStack app</a>
        <a href="https://docs.astro.build" target="_blank" rel="noreferrer">Astro docs</a>
        <a href="https://tanstack.com/start/latest" target="_blank" rel="noreferrer">
          TanStack Start docs
        </a>
      </div>

      <section class="api-card" aria-labelledby="tanstack-api-title">
        <div>
          <p class="api-label">Fetched by Astro SSR</p>
          <h2 id="tanstack-api-title">TanStack API route response</h2>
          <p>
            This card is rendered by <code>src/pages/index.astro</code>, but its data comes from
            <code>/app/demo/api/names</code> inside the mounted TanStack Start app.
          </p>
        </div>

        {tanstackApiError ? (
          <p class="api-error">{tanstackApiError}</p>
        ) : (
          <ul class="name-list" aria-label="Names returned by the TanStack API route">
            {tanstackNames.map((name) => <li>{name}</li>)}
          </ul>
        )}
      </section>
    </section>
  </main>
</BaseLayout>

<style>
  .page-shell {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    background:
      radial-gradient(circle at 20% 20%, rgba(14, 165, 233, 0.22), transparent 30%),
      radial-gradient(circle at 80% 80%, rgba(34, 197, 94, 0.2), transparent 30%),
      #0f172a;
    color: #e5eefb;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .hero-card {
    width: min(760px, 100%);
    padding: clamp(28px, 6vw, 64px);
    border: 1px solid rgba(148, 163, 184, 0.24);
    border-radius: 28px;
    background: rgba(15, 23, 42, 0.74);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.38);
  }

  .eyebrow {
    margin: 0 0 12px;
    color: #67e8f9;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    max-width: 680px;
    font-size: clamp(2.4rem, 8vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
  }

  .lede {
    max-width: 620px;
    margin: 24px 0 0;
    color: #b6c4d7;
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  a {
    color: #e5eefb;
    text-decoration: none;
    border: 1px solid rgba(148, 163, 184, 0.28);
    border-radius: 999px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.05);
  }

  a:hover {
    border-color: rgba(103, 232, 249, 0.7);
  }

  a.primary {
    color: #082f49;
    border-color: transparent;
    background: #67e8f9;
    font-weight: 700;
  }

  .api-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    margin-top: 32px;
    padding: 20px;
    border: 1px solid rgba(103, 232, 249, 0.28);
    border-radius: 22px;
    background: linear-gradient(135deg, rgba(8, 47, 73, 0.82), rgba(15, 23, 42, 0.72));
  }

  .api-label {
    margin: 0 0 8px;
    color: #86efac;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    letter-spacing: -0.04em;
  }

  .api-card p:not(.api-label):not(.api-error) {
    margin: 10px 0 0;
    color: #b6c4d7;
    line-height: 1.6;
  }

  code {
    color: #67e8f9;
  }

  .name-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    max-width: 260px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .name-list li {
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    padding: 8px 11px;
    color: #ecfeff;
    background: rgba(255, 255, 255, 0.08);
    font-weight: 700;
  }

  .api-error {
    margin: 0;
    color: #fecaca;
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .api-card {
      grid-template-columns: 1fr;
    }

    .name-list {
      justify-content: flex-start;
      max-width: none;
    }
  }
</style>
