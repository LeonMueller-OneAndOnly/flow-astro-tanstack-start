---
import { Image } from "astro:assets";

import Header from "../app/components/Header";
import { brandPageBackground } from "../app/lib/brand-theme";
import { $appPath } from "../app/lib/typesafe-paths";
import omnisImage from "../assets/demo/robot-standing-2-white.png";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = false;

const demoHubHref = $appPath({ to: "/demo" });
---

<BaseLayout
  title="Omnis"
  description="Static Astro front door for the custom app mounted under /app."
>
  <Header variant="site" client:load />
  <main class="page-shell" style={`background:${brandPageBackground.background}`}>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Omnis App</p>
        <h1>A starter kit, not a real app yet.</h1>
        <p class="lede">
          Astro serves the static front door. TanStack Start, mounted under <code>/app</code>,
          handles the interactive, app-like routes. The bundled examples live behind one link so you
          can explore them — then delete them in one move.
        </p>

        <div class="actions" aria-label="Primary actions">
          <a class="btn btn-primary" href={demoHubHref}>Browse the demos</a>
        </div>
      </div>

      <figure class="omnis-visual" aria-label="Omnis robot preview">
        <Image
          src={omnisImage}
          widths={[320, 420, 640, 840]}
          sizes="(min-width: 960px) 360px, min(420px, 100vw)"
          format="webp"
          alt="Omnis robot standing"
          class="omnis-image"
          loading="eager"
        />
      </figure>
    </section>

    <section class="section split" aria-label="Stack overview">
      <a
        class="card"
        href="https://docs.astro.build"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="card-label">Astro</span>
        <h2>Static front door</h2>
        <p>
          Marketing, content, docs, and low-interactivity SSR. Fast to ship, easy to replace. This
          page is one of them.
        </p>
        <span class="card-cta">
          Astro docs
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 7h10v10"></path>
            <path d="M7 17 17 7"></path>
          </svg>
        </span>
      </a>

      <a class="card card-filled" href={demoHubHref}>
        <span class="card-label">Demos</span>
        <h2>All under <code>/app/demo</code></h2>
        <p>
          Every example sits beneath the <code>/app/demo</code> route segment. Drop <code
            >src/app/routes/demo</code
          > and <code>src/app/lib/demo</code> to remove them all.
        </p>
        <span class="card-cta">
          Browse the demos
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </span>
      </a>

      <a
        class="card"
        href="https://tanstack.com/start"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="card-label">TanStack Start</span>
        <h2>App under <code>/app</code></h2>
        <p>
          Typed server functions, mutations, shared client/server loading, and authenticated flows
          for richer client behavior.
        </p>
        <span class="card-cta">
          TanStack Start docs
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 7h10v10"></path>
            <path d="M7 17 17 7"></path>
          </svg>
        </span>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .page-shell {
    min-height: 100vh;
    padding: clamp(18px, 3vw, 40px);
    /* Background is applied inline from brandPageBackground (src/app/lib/brand-theme.ts),
       the single source shared with the TanStack demo pages. */
    color: var(--foreground);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(36px, 6vw, 72px);
    align-items: center;
    width: min(1100px, 100%);
    margin: 0 auto;
    padding: clamp(16px, 3vw, 40px) 0 clamp(28px, 5vw, 56px);
  }

  /* Two columns when there is room: copy left, robot to the right of the title. */
  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    }
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--brand-secondary-700);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 820px;
    margin: 0 0 24px;
    font-size: clamp(3rem, 8vw, 6.4rem);
    font-weight: 950;
    line-height: 0.92;
    letter-spacing: -0.06em;
  }

  .lede {
    max-width: 680px;
    margin: 0;
    color: color-mix(in oklch, var(--foreground) 68%, transparent);
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .omnis-visual {
    overflow: hidden;
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    border: 1px solid color-mix(in oklch, var(--foreground) 14%, transparent);
    border-radius: 32px;
    background: color-mix(in oklch, var(--card) 70%, transparent);
    box-shadow: 0 30px 90px color-mix(in oklch, var(--foreground) 18%, transparent);
  }

  .omnis-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0 22px;
    font-weight: 850;
    text-decoration: none;
    transition: transform 160ms ease, border-color 180ms ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: var(--foreground);
    color: var(--background);
    box-shadow: 0 18px 36px color-mix(in oklch, var(--foreground) 18%, transparent);
  }

  .section {
    width: min(1100px, 100%);
    margin-inline: auto;
  }

  .split {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    padding-bottom: clamp(32px, 6vw, 72px);
  }

  .split .card {
    display: flex;
    flex-direction: column;
    border: 1px solid color-mix(in oklch, var(--foreground) 12%, transparent);
    border-radius: 24px;
    padding: 30px;
    background: color-mix(in oklch, var(--card) 80%, transparent);
    color: inherit;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .split .card:hover,
  .split .card:focus-visible {
    transform: translateY(-4px);
    border-color: color-mix(in oklch, var(--brand-secondary-600) 50%, transparent);
    box-shadow: 0 24px 54px color-mix(in oklch, var(--foreground) 13%, transparent);
    outline: none;
  }

  /* Demos card: brand-filled so the primary destination stands out from the two outline docs cards. */
  .split .card-filled {
    border-color: transparent;
    background: linear-gradient(135deg, var(--brand-primary-600), var(--brand-secondary-600));
    color: #fff;
  }

  .split .card-filled:hover,
  .split .card-filled:focus-visible {
    border-color: transparent;
    box-shadow: 0 28px 64px color-mix(in oklch, var(--brand-primary-600) 42%, transparent);
  }

  .card-label {
    display: block;
    margin-bottom: 16px;
    color: var(--brand-secondary-700);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .card-filled .card-label {
    color: color-mix(in oklch, white 78%, transparent);
  }

  .split h2 {
    margin: 0 0 12px;
    font-size: 1.45rem;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .split p {
    margin: 0;
    color: color-mix(in oklch, var(--foreground) 60%, transparent);
    line-height: 1.65;
  }

  .card-filled h2 {
    color: #fff;
  }

  .card-filled p {
    color: color-mix(in oklch, white 88%, transparent);
  }

  .card-filled code {
    background: color-mix(in oklch, white 22%, transparent);
    color: #fff;
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: auto;
    padding-top: 24px;
    color: var(--brand-secondary-700);
    font-size: 0.95rem;
    font-weight: 850;
  }

  .card-filled .card-cta {
    color: #fff;
  }

  .card-cta svg {
    width: 17px;
    height: 17px;
    transition: transform 180ms ease;
  }

  .split .card:hover .card-cta svg,
  .split .card:focus-visible .card-cta svg {
    transform: translateX(3px);
  }

  code {
    border-radius: 8px;
    padding: 2px 7px;
    background: color-mix(in oklch, var(--foreground) 8%, transparent);
    color: var(--brand-secondary-700);
    font-size: 0.9em;
    font-weight: 750;
  }

  @media (max-width: 820px) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .page-shell {
      padding: 16px;
    }

    .btn {
      width: 100%;
    }
  }
</style>
