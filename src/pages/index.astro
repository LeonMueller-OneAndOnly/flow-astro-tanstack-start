---
import guitars from "../app/lib/demo/data/example-guitars";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = false;

const featuredGuitars = guitars.slice(0, 3);
const heroGuitar = guitars[2] ?? guitars[0];
const lowestPrice = Math.min(...guitars.map((guitar) => guitar.price));
const highestPrice = Math.max(...guitars.map((guitar) => guitar.price));
const demoLinks = [
  {
    title: "TanStack demo hub",
    href: "/app",
    label: "Index",
    description: "The mounted TanStack Start landing page that collects the app demos.",
  },
  {
    title: "Todo server functions",
    href: "/app/demo/start/server-funcs",
    label: "Server fn",
    description: "A todo flow using loaders, server functions, mutations, and database writes.",
  },
  {
    title: "API request",
    href: "/app/demo/start/api-request",
    label: "API route",
    description: "A client page that fetches data from a colocated TanStack API handler.",
  },
  {
    title: "SSR mode hub",
    href: "/app/demo/start/ssr",
    label: "SSR",
    description: "Navigation for the rendering-mode examples in the starter.",
  },
  {
    title: "SPA mode",
    href: "/app/demo/start/ssr/spa-mode",
    label: "Client",
    description: "A no-SSR route that loads its punk-song data in the browser.",
  },
  {
    title: "Full SSR",
    href: "/app/demo/start/ssr/full-ssr",
    label: "Server",
    description: "A loader-rendered page that sends complete HTML from the server.",
  },
  {
    title: "Data-only SSR",
    href: "/app/demo/start/ssr/data-only",
    label: "Data",
    description: "A route using TanStack Start's data-only SSR mode.",
  },
  {
    title: "Client store",
    href: "/app/demo/store",
    label: "Store",
    description: "A compact TanStack Store example with derived full-name state.",
  },
  {
    title: "Upload tester",
    href: "/app/demo/start/uploads",
    label: "Files",
    description: "A Flydrive-backed upload, list, and download reference flow.",
  },
  {
    title: "Mail worker tester",
    href: "/app/demo/start/mail-worker",
    label: "Worker",
    description: "A form that queues a preview email job for the background worker.",
  },
  {
    title: "Guitar catalog",
    href: "/app/example/guitars",
    label: "Routes",
    description: "A list/detail catalog demo using TanStack dynamic route params.",
  },
];
---

<BaseLayout
  title="Astro TanStack Guitar Starter"
  description="A sharper Astro and TanStack Start starter kit built around a guitar catalog demo."
>
  <main class="page-shell">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Astro + TanStack Start</p>
        <h1>Starter kit, tuned like a boutique guitar shop.</h1>
        <p class="lede">
          Static Astro pages handle the polished front door. The mounted TanStack Start demo
          shows an app-like catalog with dynamic guitar routes when you need richer client behavior.
        </p>

        <div class="actions" aria-label="Primary actions">
          <a class="btn btn-primary" href="/app/example/guitars">Browse guitar demo</a>
          <a class="btn btn-secondary" href={`/app/example/guitars/${heroGuitar.id}`}>Open featured guitar</a>
        </div>

        <dl class="stats" aria-label="Catalog stats">
          <div>
            <dt>{guitars.length}</dt>
            <dd>demo guitars</dd>
          </div>
          <div>
            <dt>${lowestPrice}-${highestPrice}</dt>
            <dd>sample range</dd>
          </div>
          <div>
            <dt>/app/example</dt>
            <dd>mounted route</dd>
          </div>
        </dl>
      </div>

      <a class="hero-showcase" href={`/app/example/guitars/${heroGuitar.id}`} aria-label={`Open ${heroGuitar.name}`}>
        <div class="pick-card">dynamic route demo</div>
        <img src={heroGuitar.image} alt={heroGuitar.name} />
        <div class="showcase-caption">
          <span>{heroGuitar.name}</span>
          <strong>${heroGuitar.price}</strong>
        </div>
      </a>
    </section>

    <section class="section intro" aria-labelledby="starter-title">
      <div>
        <p class="eyebrow">What this proves</p>
        <h2 id="starter-title">A starter that points at a real-feeling demo, not a framework lobby.</h2>
      </div>
      <p>
        Use Astro for marketing, docs, content, and lightweight SSR. Send users straight into the
        guitar catalog when they need the TanStack Start example for nested routing, params, and
        app-style UI under the mounted <code>/app</code> boundary.
      </p>
    </section>

    <section class="guitar-grid" aria-label="Featured guitars">
      {featuredGuitars.map((guitar) => (
        <a class="guitar-card" href={`/app/example/guitars/${guitar.id}`}>
          <img src={guitar.image} alt={guitar.name} loading="lazy" />
          <div>
            <span>${guitar.price}</span>
            <h3>{guitar.name}</h3>
            <p>{guitar.shortDescription}</p>
          </div>
        </a>
      ))}
    </section>

    <section class="section demo-directory" aria-labelledby="demo-directory-title">
      <div class="demo-directory-header">
        <p class="eyebrow">Demo directory</p>
        <h2 id="demo-directory-title">Every TanStack Start demo reachable from the Astro front door.</h2>
      </div>
      <div class="demo-grid">
        {demoLinks.map((demo) => (
          <a class="demo-card" href={demo.href}>
            <span>{demo.label}</span>
            <h3>{demo.title}</h3>
            <p>{demo.description}</p>
            <code>{demo.href}</code>
          </a>
        ))}
      </div>
    </section>

    <section class="section feature-strip" aria-label="Starter capabilities">
      <div>
        <span>01</span>
        <h3>Astro-first shell</h3>
        <p>Keep simple public pages fast, static-friendly, and easy to replace.</p>
      </div>
      <div>
        <span>02</span>
        <h3>Direct demo entry</h3>
        <p>The main call to action goes to the guitar catalog instead of the generic app root.</p>
      </div>
      <div>
        <span>03</span>
        <h3>App routes when useful</h3>
        <p>TanStack Start stays focused on interactive examples under <code>/app/example/guitars</code>.</p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-shell {
    min-height: 100vh;
    overflow: hidden;
    padding: clamp(18px, 3vw, 40px);
    background:
      radial-gradient(circle at 12% 10%, color-mix(in oklch, var(--brand-primary-400) 26%, transparent), transparent 32rem),
      radial-gradient(circle at 85% 18%, color-mix(in oklch, var(--brand-secondary-500) 22%, transparent), transparent 30rem),
      linear-gradient(135deg, oklch(0.985 0.02 86), oklch(0.96 0.025 68) 42%, var(--background));
    color: var(--foreground);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 460px);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
    width: min(1180px, 100%);
    margin: 0 auto;
    padding: clamp(34px, 7vw, 92px) 0 clamp(34px, 6vw, 72px);
  }

  .hero-copy {
    position: relative;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--brand-secondary-700);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 760px;
    margin-bottom: 24px;
    font-size: clamp(3.2rem, 9vw, 7.4rem);
    font-weight: 950;
    line-height: 0.9;
    letter-spacing: -0.075em;
  }

  h2 {
    max-width: 720px;
    margin-bottom: 0;
    font-size: clamp(2rem, 4.8vw, 4.2rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .lede {
    max-width: 650px;
    margin-bottom: 0;
    color: color-mix(in oklch, var(--foreground) 68%, transparent);
    font-size: clamp(1.08rem, 2vw, 1.35rem);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0 20px;
    font-weight: 850;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: var(--foreground);
    color: var(--background);
    box-shadow: 0 18px 36px color-mix(in oklch, var(--foreground) 18%, transparent);
  }

  .btn-secondary {
    border-color: color-mix(in oklch, var(--foreground) 20%, transparent);
    background: color-mix(in oklch, var(--card) 72%, transparent);
    color: var(--foreground);
  }

  .btn-secondary:hover {
    border-color: color-mix(in oklch, var(--brand-secondary-600) 55%, transparent);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    max-width: 680px;
    margin: 44px 0 0;
  }

  .stats div {
    border: 1px solid color-mix(in oklch, var(--foreground) 12%, transparent);
    border-radius: 24px;
    padding: 18px;
    background: color-mix(in oklch, var(--card) 58%, transparent);
    backdrop-filter: blur(16px);
  }

  .stats dt {
    margin-bottom: 4px;
    font-size: clamp(1.25rem, 2.3vw, 1.8rem);
    font-weight: 950;
    letter-spacing: -0.04em;
  }

  .stats dd {
    margin: 0;
    color: color-mix(in oklch, var(--foreground) 58%, transparent);
    font-size: 0.86rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-showcase {
    position: relative;
    display: block;
    min-height: 590px;
    overflow: hidden;
    border: 1px solid color-mix(in oklch, var(--foreground) 16%, transparent);
    border-radius: 42px;
    background: oklch(0.18 0.035 65);
    box-shadow: 0 34px 90px color-mix(in oklch, var(--foreground) 18%, transparent);
    color: white;
    isolation: isolate;
    text-decoration: none;
  }

  .hero-showcase::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0%) 34%, rgb(0 0 0 / 78%)),
      radial-gradient(circle at 50% 20%, rgb(255 255 255 / 28%), transparent 20rem);
  }

  .hero-showcase img {
    width: 100%;
    height: 100%;
    min-height: 590px;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 500ms ease;
  }

  .hero-showcase:hover img {
    transform: scale(1.07);
  }

  .pick-card,
  .showcase-caption {
    position: absolute;
    z-index: 2;
  }

  .pick-card {
    top: 22px;
    left: 22px;
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: 999px;
    padding: 10px 14px;
    background: rgb(0 0 0 / 32%);
    backdrop-filter: blur(14px);
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .showcase-caption {
    right: 24px;
    bottom: 24px;
    left: 24px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
  }

  .showcase-caption span {
    max-width: 290px;
    font-size: clamp(1.5rem, 4vw, 2.8rem);
    font-weight: 950;
    line-height: 0.96;
    letter-spacing: -0.05em;
  }

  .showcase-caption strong {
    border-radius: 999px;
    padding: 12px 15px;
    background: white;
    color: black;
    font-size: 1rem;
  }

  .section,
  .guitar-grid {
    width: min(1180px, 100%);
    margin-inline: auto;
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: end;
    padding: clamp(34px, 6vw, 74px) 0;
  }

  .intro > p {
    margin-bottom: 0;
    color: color-mix(in oklch, var(--foreground) 66%, transparent);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  code {
    border-radius: 8px;
    padding: 2px 7px;
    background: color-mix(in oklch, var(--foreground) 8%, transparent);
    color: var(--brand-secondary-700);
    font-size: 0.9em;
    font-weight: 750;
  }

  .guitar-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .guitar-card {
    overflow: hidden;
    border: 1px solid color-mix(in oklch, var(--foreground) 12%, transparent);
    border-radius: 30px;
    background: color-mix(in oklch, var(--card) 74%, transparent);
    color: var(--foreground);
    text-decoration: none;
    box-shadow: 0 20px 54px color-mix(in oklch, var(--foreground) 7%, transparent);
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .guitar-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklch, var(--brand-primary-500) 38%, transparent);
  }

  .guitar-card img {
    width: 100%;
    aspect-ratio: 1.15;
    object-fit: cover;
  }

  .guitar-card div {
    padding: 20px;
  }

  .guitar-card span {
    display: inline-flex;
    margin-bottom: 12px;
    border-radius: 999px;
    padding: 7px 10px;
    background: color-mix(in oklch, var(--brand-primary-500) 12%, transparent);
    color: var(--brand-primary-800);
    font-weight: 900;
  }

  .guitar-card h3 {
    margin-bottom: 10px;
    font-size: 1.35rem;
    letter-spacing: -0.035em;
  }

  .guitar-card p {
    margin-bottom: 0;
    color: color-mix(in oklch, var(--foreground) 58%, transparent);
    line-height: 1.6;
  }

  .demo-directory {
    padding: clamp(34px, 6vw, 78px) 0 0;
  }

  .demo-directory-header {
    max-width: 820px;
    margin-bottom: 24px;
  }

  .demo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .demo-card {
    display: flex;
    min-height: 230px;
    flex-direction: column;
    border: 1px solid color-mix(in oklch, var(--foreground) 12%, transparent);
    border-radius: 26px;
    padding: 22px;
    background:
      linear-gradient(145deg, color-mix(in oklch, var(--card) 82%, transparent), color-mix(in oklch, var(--background) 76%, transparent)),
      color-mix(in oklch, var(--card) 78%, transparent);
    color: var(--foreground);
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .demo-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklch, var(--brand-secondary-600) 42%, transparent);
    box-shadow: 0 18px 44px color-mix(in oklch, var(--foreground) 8%, transparent);
  }

  .demo-card span {
    width: fit-content;
    margin-bottom: 26px;
    border-radius: 999px;
    padding: 7px 10px;
    background: color-mix(in oklch, var(--brand-secondary-500) 13%, transparent);
    color: var(--brand-secondary-800);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .demo-card h3 {
    margin-bottom: 10px;
    font-size: 1.25rem;
    letter-spacing: -0.035em;
  }

  .demo-card p {
    margin-bottom: 20px;
    color: color-mix(in oklch, var(--foreground) 60%, transparent);
    line-height: 1.6;
  }

  .demo-card code {
    width: fit-content;
    margin-top: auto;
  }

  .feature-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    margin-top: 18px;
    margin-bottom: clamp(24px, 5vw, 64px);
    border: 1px solid color-mix(in oklch, var(--foreground) 12%, transparent);
    border-radius: 30px;
    background: color-mix(in oklch, var(--foreground) 12%, transparent);
  }

  .feature-strip div {
    padding: clamp(22px, 4vw, 34px);
    background: color-mix(in oklch, var(--card) 76%, transparent);
  }

  .feature-strip span {
    display: block;
    margin-bottom: 42px;
    color: var(--brand-secondary-700);
    font-weight: 950;
  }

  .feature-strip h3 {
    margin-bottom: 10px;
    font-size: 1.3rem;
    letter-spacing: -0.035em;
  }

  .feature-strip p {
    margin-bottom: 0;
    color: color-mix(in oklch, var(--foreground) 60%, transparent);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .hero,
    .intro,
    .guitar-grid,
    .demo-grid,
    .feature-strip {
      grid-template-columns: 1fr;
    }

    .hero-showcase,
    .hero-showcase img {
      min-height: 460px;
    }
  }

  @media (max-width: 640px) {
    .page-shell {
      padding: 16px;
    }

    .actions,
    .stats {
      grid-template-columns: 1fr;
    }

    .btn {
      width: 100%;
    }

    .showcase-caption {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
