---
import { isContentPath, NOINDEX } from "../app/lib/content-paths";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Omnis Start",
  description = "A shared Astro and TanStack Start application shell.",
} = Astro.props;

const robots = isContentPath(Astro.url.pathname) ? undefined : NOINDEX;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* MDN's standard boilerplate. `width=device-width` alone behaves the same
        on current browsers — the orientation-zoom bug initial-scale used to
        work around was fixed in iOS 6 — so this is convention, not a fix. */}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {/* iOS Safari stops delivering pointer events to a React tree whose root
        container has `display: contents` (facebook/react#29890), and Astro sets
        exactly that on every island. Radix triggers open on `pointerdown` alone
        (radix-ui/primitives#2580), so an island menu renders and then ignores
        every tap on an iPhone. Attaching one no-op listener to the body is the
        workaround from both threads: it makes WebKit deliver pointer events for
        the whole document again. Inline and unbundled so it runs before any
        island hydrates. Not needed in the TanStack Start shell under /app,
        where React owns the document and no `display: contents` root exists. */}
    <script is:inline>
      document.body.addEventListener("pointerdown", () => {}, { passive: true });
    </script>
  </body>
</html>
