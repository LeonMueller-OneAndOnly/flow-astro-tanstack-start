---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

import { isContentPath } from "../app/lib/framework/content-paths";
import { buildMetaTags, HEAD_LINKS, NOINDEX, SITE } from "../app/lib/framework/site-meta";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  /** `article` for a single piece of content, `website` for index and utility pages. */
  ogType?: "website" | "article";
  /**
   * Preview image, taken as an imported asset so Astro can process it. Cropped to
   * the card box here; without one the brand logo is used and the card falls back
   * to the small square layout.
   */
  image?: { src: ImageMetadata; alt: string };
}

const {
  title = SITE.name,
  description = SITE.description,
  ogType = "website",
  image,
} = Astro.props;

// Scrapers have no document base to resolve against, so every URL in a meta tag
// has to be absolute. `Astro.site` is APP_ORIGIN (see astro.config.ts).
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const preview = image
  ? await getImage({
      src: image.src,
      width: SITE.ogImageWidth,
      height: SITE.ogImageHeight,
      fit: "cover",
      format: "jpeg",
    })
  : undefined;

const metaTags = buildMetaTags({
  title,
  description,
  robots: isContentPath(Astro.url.pathname) ? undefined : NOINDEX,
  social: {
    url: canonical,
    imageUrl: new URL(preview?.src ?? SITE.fallbackImage, Astro.site).href,
    imageAlt: image?.alt ?? SITE.name,
    type: ogType,
    imageIsSized: preview !== undefined,
  },
});
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    {/* First, because the charset tag has to land inside the document's first
        1024 bytes to be honoured. */}
    {metaTags.map((tag) => <meta {...tag} />)}
    <meta name="generator" content={Astro.generator} />
    {HEAD_LINKS.map((link) => <link {...link} />)}
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {/* iOS Safari stops delivering pointer events to a React tree whose root
        container has `display: contents` (facebook/react#29890), and Astro sets
        exactly that on every island. Radix triggers open on `pointerdown` alone
        (radix-ui/primitives#2580), so an island menu renders and then ignores
        every tap on an iPhone. Attaching one no-op listener to the body is the
        workaround from both threads: it makes WebKit deliver pointer events for
        the whole document again. Inline and unbundled so it runs before any
        island hydrates. Not needed in the TanStack Start shell under /app,
        where React owns the document and no `display: contents` root exists. */}
    <script is:inline>
      document.body.addEventListener("pointerdown", () => {}, { passive: true });
    </script>
  </body>
</html>
