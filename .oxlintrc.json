{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest", "import"],
  "categories": {
    "correctness": "error"
  },
  "jsPlugins": ["./oxlint-rules/astro-pages.js", "eslint-plugin-better-tailwindcss"],
  "settings": {
    "better-tailwindcss": {
      "entryPoint": "./src/styles/globals.css"
    }
  },
  "ignorePatterns": [".claude", ".agents"],
  "rules": {
    "react/rules-of-hooks": "error",
    "import/no-cycle": "error",
    "typescript/no-unused-vars": "off",
    "typescript/triple-slash-reference": "off",
    "omvin/require-prerender-export": "error",
    "better-tailwindcss/no-conflicting-classes": "warn",
    "better-tailwindcss/no-unknown-classes": "warn"
  },
  "overrides": [
    {
      // TanStack Start's production manifest gets no CSS from the build composed with
      // Astro, so a stylesheet imported here is never linked in the SSR HTML and the
      // page renders unstyled until its JS loads. Styles go through src/styles/globals.css.
      "files": ["src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "\\.(css|scss|sass|less|styl|pcss)$",
                "message": "Never linked in production SSR HTML here. Import it with `?url` and add it to head().links, or put the styles in src/styles/globals.css."
              }
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
